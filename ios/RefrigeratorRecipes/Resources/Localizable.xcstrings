    "Warm spices, preserved lemon and couscous from Morocco and its neighbors." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Especias cálidas, limón en conserva y cuscús de Marruecos y sus vecinos."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모로코와 주변 지역의 따뜻한 향신료, 절인 레몬, 쿠스쿠스."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自摩洛哥及其邻国的温暖香料、腌柠檬和库斯库斯。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Warm, rich and familiar: the bowl-on-the-couch dinner." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calientita, sabrosa y conocida: la cena para comer en el sillón."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "따뜻하고 진하고 익숙한 맛: 소파에서 한 그릇 먹는 저녁."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温暖、浓郁又熟悉：窝在沙发上捧碗吃的晚餐。"
          }
        }
      }
    },
