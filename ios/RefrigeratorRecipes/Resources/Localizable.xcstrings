          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 기분은 어떠세요?"
          }
        }
      }
    },
    "What's for dinner?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué hay de cenar?"
          }
        },
