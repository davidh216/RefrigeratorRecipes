    "What are you in the mood for?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué se te antoja?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
