    "Add a few recipes and Tonight will suggest what to cook from what you have." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega algunas recetas y Esta noche te sugerirá qué cocinar con lo que tienes."
          }
