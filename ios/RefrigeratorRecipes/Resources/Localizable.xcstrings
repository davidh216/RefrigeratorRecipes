    "Pasta, slow sauces and simple, ingredient-first cooking from Italy's regions." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta, salsas a fuego lento y cocina sencilla que respeta el ingrediente, de las regiones de Italia."
          }
