    "Based on a typical adult. Add age, height and weight for a closer number." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según un adulto promedio. Agrega edad, estatura y peso para un número más preciso."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 성인 기준이에요. 나이, 키, 몸무게를 추가하면 더 정확해져요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按普通成年人估算。添加年龄、身高和体重可得到更准确的数字。"
          }
        }
      }
    },
    "Beans and rice, slow stews and big-flavored grills from Brazil." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frijoles con arroz, guisos lentos y parrilladas llenas de sabor de Brasil."
          }
