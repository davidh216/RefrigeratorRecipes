    "\"Expiring soon\" = within %lld days" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Usar pronto” = en %lld días o menos"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘빨리 먹기’ = %lld일 이내"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“尽快食用” = %lld 天内"
          }
        }
      }
    },
    "%@ expires in %lld days. Ask the chef for ideas." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vence en %lld días. Pídele ideas al chef."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 유통기한이 %lld일 남았어요. 셰프에게 아이디어를 물어보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 还有 %2$lld 天过期。问问大厨有什么做法。"
          }
        }
      }
    },
    "%@ expires today." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vence hoy."
