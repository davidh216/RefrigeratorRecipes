    "Recipes" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recetas"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레시피"
          }
        }
      }
    },
    "Recipes containing these are left out of Tonight and Plan my week, and flagged everywhere else. Gluten covers wheat, barley and rye." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las recetas que los contienen se excluyen de Esta noche y Planear mi semana, y se marcan en todo lo demás. El gluten incluye trigo, cebada y centeno."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 재료가 들어간 레시피는 오늘 저녁과 내 주간 식단 짜기에서 제외되고, 다른 곳에서는 표시돼요. 글루텐에는 밀, 보리, 호밀이 포함돼요."
          }
        }
      }
    },
    "Recipes keep their own amounts; this changes how they're shown. Fridge is in English and Spanish, and the chef replies in the app's language. Change the language in the Settings app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las recetas conservan sus cantidades; esto cambia cómo se muestran. Fridge está en inglés y español, y el chef responde en el idioma de la app. Cambia el idioma en la app Ajustes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레시피의 분량은 그대로이고, 표시 방식만 바뀌어요. Fridge는 영어와 스페인어를 지원하며, 셰프는 앱 언어로 답해요. 언어는 설정 앱에서 변경하세요."
          }
        }
      }
    },
    "Recipes you haven't saved yet are added to Recipes when you open them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las recetas que aún no guardaste se agregan a Recetas cuando las abres."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 저장하지 않은 레시피는 열면 레시피에 추가돼요."
          }
        }
      }
    },
