        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 유통기한이 오늘까지예요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 今天过期。"
          }
        }
