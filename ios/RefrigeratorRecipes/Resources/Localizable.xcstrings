        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레시피를 몇 개 추가하면 ‘오늘 저녁’에서 있는 재료로 만들 요리를 추천해 드려요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
