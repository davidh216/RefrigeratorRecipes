    "That doesn't look like a link." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso no parece un enlace."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크가 아닌 것 같아요."
          }
        },
        "zh-Hans" : {
