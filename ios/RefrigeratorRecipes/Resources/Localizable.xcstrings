    "‘Use soon’ means within %lld days. Change it under Expiration reminders." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Usar pronto’ significa en %lld días o menos. Cámbialo en Recordatorios de vencimiento."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘빨리 먹기’는 %lld일 이내를 뜻해요. 유통기한 알림에서 변경하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“尽快食用”指 %lld 天内。可在“过期提醒”中更改。"
          }
        }
      }
    },
