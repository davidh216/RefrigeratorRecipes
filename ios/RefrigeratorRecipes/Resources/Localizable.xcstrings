    "Allergy check isn't available in this recipe's language. Check the ingredients yourself." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La revisión de alergias no está disponible en el idioma de esta receta. Revisa tú los ingredientes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 레시피의 언어로는 알레르기 확인을 할 수 없어요. 재료를 직접 확인하세요."
          }
        }
      }
    },
    "Allow Speech Recognition in Settings so the app can listen to the video." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el Reconocimiento de voz en Ajustes para que la app pueda escuchar el video."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 동영상을 들을 수 있도록 설정에서 음성 인식을 허용하세요."
          }
        }
      }
    },
    "Allspice, thyme and citrus from Jamaican, Cuban, Puerto Rican and Dominican kitchens." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pimienta gorda, tomillo y cítricos de las cocinas jamaiquina, cubana, puertorriqueña y dominicana."
          }
        },
        "ko" : {
