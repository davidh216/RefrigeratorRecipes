    "1 recipe, ones you can make first" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 receta, primero las que puedes hacer"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레시피 1개, 만들 수 있는 것부터"
          }
        },
