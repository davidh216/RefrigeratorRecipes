            "value" : "주간 알림"
          }
        }
      }
    },
    "Weeknight dinners, breakfasts and snacks from around the world, so Tonight has something to suggest from day one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cenas entre semana, desayunos y botanas de todo el mundo, para que Esta noche tenga qué sugerir desde el primer día."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전 세계의 평일 저녁, 아침 식사, 간식 레시피로 첫날부터 오늘 저녁에서 추천할 거리가 있어요."
          }
        }
      }
    },
    "Welcome to Fridge" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te damos la bienvenida a Fridge"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fridge에 오신 것을 환영해요"
          }
        }
      }
    },
    "West African" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De África Occidental"
